# Copy this file to ".env" (same folder) and fill in your Supabase project values.
# The ".env" file is ignored by git. Leave both empty to run the built-in demo backend.
#
# Supabase dashboard > Project Settings > API:
#   Project URL      -> SUPABASE_URL      (looks like https://abcdefgh.supabase.co)
#   anon public key  -> SUPABASE_ANON_KEY (the "anon" key. NEVER the "service_role" key)
SUPABASE_URL=
SUPABASE_ANON_KEY=
